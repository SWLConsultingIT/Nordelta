{
  "name": "nordelta-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verificar": "vitest run && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:supabase": "vitest run --config vitest.supabase.config.mts",
    "migrar:legacy": "tsx scripts/migrar-legacy.mts",
    "fullcarga:poc": "tsx scripts/fullcarga-poc.mts",
    "fullcarga:parse": "tsx scripts/fullcarga-parse-poc.mts",
    "fullcarga:multidia": "tsx scripts/fullcarga-multidia.mts",
    "fullcarga:comparar": "tsx scripts/fullcarga-comparar.mts",
    "conciliar": "tsx scripts/conciliar-poc.mts",
    "ground-truth": "tsx scripts/ground-truth.mts",
    "benchmark": "tsx scripts/benchmark-independiente.mts",
    "supabase:seed": "tsx --tsconfig tsconfig.scripts.json scripts/supabase-seed.mts",
    "supabase:rls": "tsx --tsconfig tsconfig.scripts.json scripts/supabase-rls.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "ag-grid-community": "^36.1.0",
    "ag-grid-react": "^36.1.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
